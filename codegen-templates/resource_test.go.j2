// Provider default_tags tests

func TestAccProviderDefaultTags(t *testing.T) {
	name := fmt.Sprintf("test-default-tags-%s", randomSuffix())
	resource.Test(t, resource.TestCase{
		PreCheck:                 func() { testAccPreCheck(t) },
		ProtoV6ProviderFactories: testAccProtoV6ProviderFactories,
		Steps: []resource.TestStep{
			// Default tags are merged into tags_all; resource tags win on conflicts
			{
				Config: testAccProviderDefaultTagsConfig(name, `
    managed_by = "terraform"
    test       = "overridden"
`),
				Check: resource.ComposeAggregateTestCheckFunc(
					resource.TestCheckResourceAttr("blastshield_service.test", "tags.%", "1"),
					resource.TestCheckResourceAttr("blastshield_service.test", "tags.test", TestTag),
					resource.TestCheckResourceAttr("blastshield_service.test", "tags_all.%", "2"),
					resource.TestCheckResourceAttr("blastshield_service.test", "tags_all.managed_by", "terraform"),
					resource.TestCheckResourceAttr("blastshield_service.test", "tags_all.test", TestTag),
					resource.TestCheckResourceAttr("blastshield_service.untagged", "tags.%", "0"),
					resource.TestCheckResourceAttr("blastshield_service.untagged", "tags_all.%", "2"),
					resource.TestCheckResourceAttr("blastshield_service.untagged", "tags_all.managed_by", "terraform"),
					resource.TestCheckResourceAttr("blastshield_service.untagged", "tags_all.test", "overridden"),
				),
			},
			// Import splits default tags back out of tags
			{
				Config:            testAccProviderDefaultTagsConfig(name, `    managed_by = "terraform"`),
				ResourceName:      "blastshield_service.test",
				ImportState:       true,
				ImportStateVerify: true,
			},
			// Changing a default tag updates tags_all only, also on resources without
			// tags, and removing one (test) drops it there
			{
				Config: testAccProviderDefaultTagsConfig(name, `    managed_by = "terraform-updated"`),
				Check: resource.ComposeAggregateTestCheckFunc(
					resource.TestCheckResourceAttr("blastshield_service.test", "tags.%", "1"),
					resource.TestCheckResourceAttr("blastshield_service.test", "tags_all.%", "2"),
					resource.TestCheckResourceAttr("blastshield_service.test", "tags_all.managed_by", "terraform-updated"),
					resource.TestCheckResourceAttr("blastshield_service.untagged", "tags.%", "0"),
					resource.TestCheckResourceAttr("blastshield_service.untagged", "tags_all.%", "1"),
					resource.TestCheckResourceAttr("blastshield_service.untagged", "tags_all.managed_by", "terraform-updated"),
				),
			},
			// Removing default tags removes them from the resource
			{
				Config: testAccProviderDefaultTagsConfig(name, ""),
				Check: resource.ComposeAggregateTestCheckFunc(
					resource.TestCheckResourceAttr("blastshield_service.test", "tags.%", "1"),
					resource.TestCheckResourceAttr("blastshield_service.test", "tags_all.%", "1"),
					resource.TestCheckResourceAttr("blastshield_service.test", "tags_all.test", TestTag),
					resource.TestCheckResourceAttr("blastshield_service.untagged", "tags.%", "0"),
					resource.TestCheckResourceAttr("blastshield_service.untagged", "tags_all.%", "0"),
				),
			},
		},
	})
}

