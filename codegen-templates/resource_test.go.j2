// plan changes for the resources referencing it.

func TestAccPlanStability_crossResource(t *testing.T) {
	suffix := randomSuffix()
	// Random locally administered MAC, so concurrent runs (e.g. per-version packages) don't collide
	mac := fmt.Sprintf("02:00:00:%02x:%02x:%02x", rand.Intn(256), rand.Intn(256), rand.Intn(256))
	unchanged := func(addrs ...string) []plancheck.PlanCheck {
		checks := make([]plancheck.PlanCheck, len(addrs))
		for i, addr := range addrs {
			checks[i] = plancheck.ExpectResourceAction(addr, plancheck.ResourceActionNoop)
		}
		return checks
	}
	resource.Test(t, resource.TestCase{
		PreCheck:                 func() { testAccPreCheck(t) },
		ProtoV6ProviderFactories: testAccProtoV6ProviderFactories,
		Steps: []resource.TestStep{
			// Converge: the post-apply plan must be empty
			{
				Config: testAccPlanStabilityConfig(suffix, "80", "test-plan-ep-"+suffix, mac),
			},
			// Updating a referenced service must not ripple into the policy
			{
				Config: testAccPlanStabilityConfig(suffix, "443", "test-plan-ep-"+suffix, mac),
				ConfigPlanChecks: resource.ConfigPlanChecks{
					PreApply: append(
						[]plancheck.PlanCheck{plancheck.ExpectResourceAction("blastshield_service.test", plancheck.ResourceActionUpdate)},
						unchanged(
							"blastshield_node.gateway",
							"blastshield_endpoint.test",
							"blastshield_group.members",
							"blastshield_group.other",
							"blastshield_policy.test",
						)...,
					),
				},
			},
			// Updating a group member endpoint must not ripple into the group or policy
			{
				Config: testAccPlanStabilityConfig(suffix, "443", "test-plan-ep-"+suffix+"-renamed", mac),
				ConfigPlanChecks: resource.ConfigPlanChecks{
					PreApply: append(
						[]plancheck.PlanCheck{plancheck.ExpectResourceAction("blastshield_endpoint.test", plancheck.ResourceActionUpdate)},
						unchanged(
							"blastshield_node.gateway",
							"blastshield_service.test",
							"blastshield_group.members",
							"blastshield_group.other",
							"blastshield_policy.test",
