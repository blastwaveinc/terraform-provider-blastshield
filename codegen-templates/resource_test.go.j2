// Device security posture attribute tests

func TestAccDeviceSecurityPostureResource_attributes(t *testing.T) {
	name := fmt.Sprintf("test-device_security_posture-attrs-%s", randomSuffix())
	resource.Test(t, resource.TestCase{
		PreCheck:                 func() { testAccPreCheck(t) },
		ProtoV6ProviderFactories: testAccProtoV6ProviderFactories,
		Steps: []resource.TestStep{
			// Set platform attributes; unset platforms stay null
			{
				Config: testAccDeviceSecurityPostureConfig_attributes(name, `
  windows_attr = {
    secure_boot  = true
    min_os_build = "26100"
    model        = ["model-a"]
  }
`),
				Check: resource.ComposeAggregateTestCheckFunc(
					resource.TestCheckResourceAttr("blastshield_device_security_posture.test", "windows_attr.secure_boot", "true"),
					resource.TestCheckResourceAttr("blastshield_device_security_posture.test", "windows_attr.min_os_build", "26100"),
					resource.TestCheckResourceAttr("blastshield_device_security_posture.test", "windows_attr.model.#", "1"),
					resource.TestCheckNoResourceAttr("blastshield_device_security_posture.test", "windows_attr.rdp_enabled"),
					resource.TestCheckNoResourceAttr("blastshield_device_security_posture.test", "linux_attr.hardware_keystore"),
				),
			},
			// Change and remove attributes, and add another platform
			{
				Config: testAccDeviceSecurityPostureConfig_attributes(name, `
  windows_attr = {
    secure_boot = false
    model       = ["model-a", "model-b"]
  }
  linux_attr = {
    hardware_keystore = true
  }
`),
				Check: resource.ComposeAggregateTestCheckFunc(
					resource.TestCheckResourceAttr("blastshield_device_security_posture.test", "windows_attr.secure_boot", "false"),
					resource.TestCheckNoResourceAttr("blastshield_device_security_posture.test", "windows_attr.min_os_build"),
					resource.TestCheckResourceAttr("blastshield_device_security_posture.test", "windows_attr.model.#", "2"),
					resource.TestCheckResourceAttr("blastshield_device_security_posture.test", "linux_attr.hardware_keystore", "true"),
				),
			},
			// Removing a platform block clears it on the server (the post-apply plan
			// would not be empty if the server kept it)
			{
				Config: testAccDeviceSecurityPostureConfig_attributes(name, `
  windows_attr = {
    secure_boot = false
    model       = ["model-a", "model-b"]
  }
`),
				ConfigPlanChecks: resource.ConfigPlanChecks{
					PreApply: []plancheck.PlanCheck{
						plancheck.ExpectResourceAction("blastshield_device_security_posture.test", plancheck.ResourceActionUpdate),
					},
				},
				Check: resource.ComposeAggregateTestCheckFunc(
					resource.TestCheckResourceAttr("blastshield_device_security_posture.test", "windows_attr.secure_boot", "false"),
					resource.TestCheckNoResourceAttr("blastshield_device_security_posture.test", "linux_attr.hardware_keystore"),
				),
			},
			// Removing the last platform block leaves a posture without requirements
			{
				Config: testAccDeviceSecurityPostureConfig_attributes(name, ""),
				ConfigPlanChecks: resource.ConfigPlanChecks{
					PreApply: []plancheck.PlanCheck{
						plancheck.ExpectResourceAction("blastshield_device_security_posture.test", plancheck.ResourceActionUpdate),
					},
				},
				Check: resource.ComposeAggregateTestCheckFunc(
					resource.TestCheckNoResourceAttr("blastshield_device_security_posture.test", "windows_attr.secure_boot"),
					resource.TestCheckNoResourceAttr("blastshield_device_security_posture.test", "windows_attr.model.#"),
				),
			},
			// Empty platform blocks select platforms without any requirements (as in
			// the resource example)
			{
				Config: testAccDeviceSecurityPostureConfig_attributes(name, `
  windows_attr = {}
  macos_attr   = {}
`),
				ConfigStateChecks: []statecheck.StateCheck{
					statecheck.ExpectKnownValue("blastshield_device_security_posture.test", tfjsonpath.New("windows_attr"), knownvalue.NotNull()),
					statecheck.ExpectKnownValue("blastshield_device_security_posture.test", tfjsonpath.New("macos_attr"), knownvalue.NotNull()),
					statecheck.ExpectKnownValue("blastshield_device_security_posture.test", tfjsonpath.New("linux_attr"), knownvalue.Null()),
				},
			},
			{
				ResourceName:      "blastshield_device_security_posture.test",
				ImportState:       true,
				ImportStateVerify: true,
			},
		},
	})
}

